{{!
    @template local_bonifica/costs

    Costs of the group, one row per company (or one row for a bonificada entity).

    Example context (json):
    { "company": true, "pro": false, "maxfundable": "Máximo bonificable: 1.950,00 €", "source": "Módulos de la Orden TAS/2307/2007.",
      "sesskey": "abc", "actionurl": "/local/bonifica/course.php?id=2", "footer": "Bonifica comprueba el formato.",
      "heads": [{"label": "Costes directos"}],
      "rows": [{"id": 1, "isnew": false, "cif": {"value": "B12345678"}, "razon": {"value": "Lácteos Vega S.L."}, "plantilla": {"value": "40"},
        "cells": [{"name": "directos", "value": "1200,00"}]}] }
}}
<h3 class="bA-h">{{#str}}tab_costes, local_bonifica{{/str}}</h3>
<p class="text-muted">{{#str}}costs_help, local_bonifica{{/str}}</p>
<form method="post" action="{{actionurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="costs">
<div class="bC-sheet"><table class="bon-costs">
<thead><tr>{{#company}}<th>{{#str}}col_cif, local_bonifica{{/str}}</th><th>{{#str}}col_razon, local_bonifica{{/str}}</th><th title="{{#str}}plantilla_desc, local_bonifica{{/str}}">{{#str}}plantilla, local_bonifica{{/str}}</th>{{/company}}{{#heads}}<th>{{label}}</th>{{/heads}}<th></th></tr></thead>
<tbody>
{{#rows}}
<tr class="{{#isnew}}bon-new{{/isnew}}">
{{#company}}
<td class="{{#cif.error}}bad{{/cif.error}}"><input class="bC-cell mono" name="costs[{{id}}][cif]" value="{{cif.value}}" size="10" aria-label="{{#str}}col_cif, local_bonifica{{/str}}"{{#isnew}} placeholder="{{#str}}addcompany, local_bonifica{{/str}}"{{/isnew}}><div class="why">{{cif.error}}</div></td>
<td><input class="bC-cell" name="costs[{{id}}][razon]" value="{{razon.value}}" size="22" aria-label="{{#str}}col_razon, local_bonifica{{/str}}"></td>
<td><input class="bC-cell" name="costs[{{id}}][plantilla]" value="{{plantilla.value}}" size="5" inputmode="numeric" aria-label="{{#str}}plantilla, local_bonifica{{/str}}"></td>
{{/company}}
{{#cells}}<td class="{{#error}}bad{{/error}}"><input class="bC-cell mono text-end" name="costs[{{id}}][{{name}}]" value="{{value}}" size="9" inputmode="decimal"><div class="why">{{error}}</div></td>{{/cells}}
<td>{{^isnew}}<button class="btn btn-link btn-sm text-danger" name="delcost" value="{{id}}" title="{{#str}}deletecost, local_bonifica{{/str}}">×</button>{{/isnew}}</td>
</tr>
{{/rows}}
</tbody></table></div>
<div class="mt-3"><button class="btn btn-primary">{{#str}}savechanges{{/str}}</button></div>
</form>
<p class="bA-note">{{footer}}</p>
