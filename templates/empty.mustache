{{!
    @template local_bonifica/empty

    First visit: what Bonifica does and a button to start.

    Example context (json):
    { "url": "/local/bonifica/course.php?id=2", "sesskey": "abc" }
}}
<div class="bA-title">{{#icon}}{{> local_bonifica/icon}}{{/icon}}<h2>{{#str}}title, local_bonifica{{/str}}</h2></div>
<div class="bon-empty card"><div class="card-body">
    <h3>{{#str}}intro_title, local_bonifica{{/str}}</h3>
    <p class="text-muted">{{#str}}intro_text, local_bonifica{{/str}}</p>
    <form method="post" action="{{url}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="do" value="start">
    <button class="btn btn-primary">{{#str}}start, local_bonifica{{/str}}</button></form>
</div></div>
<p class="bA-note">{{#str}}footer, local_bonifica{{/str}}</p>
